),
response = factor(
response,
levels = c("Weak", "Strong")
)
)
# Sum coding
contrasts(trial_auc_for_analysis$response) <- contr.sum(nlevels(trial_auc_for_analysis$response))
contrasts(trial_auc_for_analysis$condition) <- contr.sum(nlevels(trial_auc_for_analysis$condition))
auc_model <- lmer(AUC ~ response * condition + (1+response * condition|participant_id), data = trial_auc_for_analysis)
summary(auc_model)
auc_model <- lmer(AUC ~ response * condition + (1+response + condition|participant_id), data = trial_auc_for_analysis)
summary(auc_model)
auc_model <- lmer(AUC ~ response * condition + (1+response * condition|participant_id), data = trial_auc_for_analysis)
summary(auc_model)
trial_auc_for_analysis <- trial_auc_for_analysis %>%
mutate(
response_c = if_else(response == "Strong", 0.5, -0.5),
condition_c = if_else(condition == "Strong prime", 0.5, -0.5),
interaction_c = response_c * condition_c
)
auc_model_uncorrelated <- lmer(
AUC ~ response_c * condition_c +
(1 | participant_id) +
(0 + response_c | participant_id) +
(0 + condition_c | participant_id) +
(0 + interaction_c | participant_id),
data = trial_auc_for_analysis
)
auc_model_simplified <- lmer(
AUC ~ response_c * condition_c +
(1 | participant_id) +
(0 + response_c | participant_id) +
(0 + condition_c | participant_id),
data = trial_auc_for_analysis
)
summary(auc_model_simplified)
auc_model <- lmer(AUC ~ response * condition + (1+response |participant_id), data = trial_auc_for_analysis)
summary(auc_model)

linewidth = 0.9
) +
scale_x_discrete(
labels = c(
"Strong prime" = "Strong speaker",
"Weak prime" = "Weak speaker"
)
) +
scale_fill_manual(
values = c(
"Strong" = cbPalette[1],
"Weak" = cbPalette[2]
),
name = "Response"
) +
labs(
x = "Speaker identity",
y = "Mean area under the curve"
) +
theme_bw() +
theme(
legend.position = "bottom",
axis.title = element_text(size = 16),
axis.text = element_text(size = 14),
legend.title = element_text(size = 14),
legend.text = element_text(size = 13)
)
auc_plot

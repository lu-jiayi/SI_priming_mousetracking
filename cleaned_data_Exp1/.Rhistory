library(plyr)
library(dplyr)
library(reshape)
library(ggplot2)
library(gtable)
library(lme4)
library(tidyverse)
library(lmerTest)
library(bootstrap)
library(ggpubr)
library(stringr)
library(brms)
library(BayesFactor)
library(bootstrap)
library(mousetrap)
theta <- function(x, xdata, na.rm = TRUE) {
mean(xdata[x], na.rm = na.rm)
}
ci.low <- function(x, na.rm = TRUE) {
mean(x, na.rm = na.rm) -
quantile(
bootstrap::bootstrap(1:length(x), 1000, theta, x, na.rm = na.rm)$thetastar,
.025,
na.rm = na.rm
)
}
ci.high <- function(x, na.rm = TRUE) {
quantile(
bootstrap::bootstrap(1:length(x), 1000, theta, x, na.rm = na.rm)$thetastar,
.975,
na.rm = na.rm
) - mean(x, na.rm = na.rm)
}
cbPalette <- c("#d55e00", "#009e74", "#e69d00", "#cc79a7", "#0071b2")
`%notin%` <- Negate(`%in%`)
data<-read.csv("trials.csv")
target_data <- data %>%
filter(
trial_type == "3",
condition %in% c("strong-prime", "weak-prime"),
valid_response
) %>%
mutate(
response = case_when(
selected_picture == "cover.png" ~ "strong",
!is.na(selected_picture) ~ "weak",
TRUE ~ NA_character_
),
condition = factor(
condition,
levels = c("strong-prime", "weak-prime"),
labels = c("Strong prime", "Weak prime")
),
response = factor(
response,
levels = c("strong", "weak"),
labels = c("Strong", "Weak")
)
)
# Calculate response rates separately for each participant and condition
participant_rates <- target_data %>%
count(participant_id, condition, response, name = "n") %>%
tidyr::complete(
tidyr::nesting(participant_id, condition),
response,
fill = list(n = 0)
) %>%
group_by(participant_id, condition) %>%
mutate(
total = sum(n),
response_rate = n / total
) %>%
ungroup()
# Average participant-level rates and calculate bootstrap 95% CIs
response_summary <- participant_rates %>%
group_by(condition, response) %>%
summarise(
Mean = mean(response_rate, na.rm = TRUE),
CILow = ci.low(response_rate),
CIHigh = ci.high(response_rate),
.groups = "drop"
) %>%
mutate(
YMin = Mean - CILow,
YMax = Mean + CIHigh
)
# Bar plot
response_plot <- ggplot(
response_summary,
aes(x = condition, y = Mean, fill = response)
) +
geom_col(
position = position_dodge(width = 0.8),
width = 0.7
) +
geom_errorbar(
aes(ymin = YMin, ymax = YMax),
position = position_dodge(width = 0.8),
width = 0.25,
linewidth = 0.9
) +
scale_fill_manual(
values = cbPalette[1:2],
name = "Response"
) +
scale_y_continuous(
labels = scales::percent_format(accuracy = 1),
breaks = seq(0, 1, by = 0.2)
) +
coord_cartesian(ylim = c(0, 1)) +
labs(
x = "Prime condition",
y = "Mean response rate"
) +
theme_bw() +
theme(
legend.position = "bottom",
axis.title = element_text(size = 16),
axis.text = element_text(size = 14),
legend.title = element_text(size = 14),
legend.text = element_text(size = 13)
)
response_plot
mouse_data <- read_csv(
"mouse_trajectories.csv",
show_col_types = FALSE
)
mouse_long <- mouse_data %>%
filter(
valid_response,
trial_type == "3",
condition %in% c("strong-prime", "weak-prime")
) %>%
mutate(
# Participant's semantic response
response = case_when(
selected_picture == "cover.png" ~ "Strong",
!is.na(selected_picture) ~ "Weak",
TRUE ~ NA_character_
),
# Desired endpoint after mirroring:
# strong-prime = right; weak-prime = left
condition_side = case_when(
condition == "strong-prime" ~ "right",
condition == "weak-prime"   ~ "left",
TRUE ~ NA_character_
),
# Normalize coordinates
x_raw = x_px / trace_width_px,
y_raw = y_px / trace_height_px,
# Mirror whenever the selected option was not on the side
# assigned to that prime condition
xpos = if_else(
selected_side != condition_side,
1 - x_raw,
x_raw
),
# Browser y coordinates increase downward
ypos = 1 - y_raw,
timestamps = time_ms,
mt_seq = sample_index,
mt_id = paste(participant_id, item_order, sep = "_"),
condition = factor(
condition,
levels = c("strong-prime", "weak-prime"),
labels = c("Strong prime", "Weak prime")
),
response = factor(
response,
levels = c("Strong", "Weak")
)
) %>%
filter(
!is.na(response),
!is.na(selected_side),
!is.na(condition_side),
!is.na(xpos),
!is.na(ypos)
) %>%
transmute(
mt_id,
mt_seq,
timestamps,
xpos,
ypos,
participant_id,
condition,
response
)
#2. mousetrap normalize time
mt_data <- mt_import_long(
raw_data = mouse_long,
xpos_label = "xpos",
ypos_label = "ypos",
timestamps_label = "timestamps",
mt_id_label = "mt_id",
mt_seq_label = "mt_seq",
reset_timestamps = TRUE
)
mt_data <- mt_time_normalize(mt_data)
#3. Plot
trajectory_plot <- mt_plot_aggregate(
mt_data,
use = "tn_trajectories",
color = "response",
facet_row = "condition",
facet_col = "response",
subject_id = "participant_id",
size = 1.5
) +
scale_color_manual(
values = c(
"Strong" = cbPalette[1],
"Weak" = cbPalette[2]
),
name = "Response"
) +
coord_equal(
xlim = c(0, 1),
ylim = c(0, 1)
) +
labs(
x = "Mouse position",
y = "Mouse position"
) +
theme_bw() +
theme(
legend.position = "bottom",
axis.title = element_text(size = 15),
axis.text = element_text(size = 12),
strip.text = element_text(size = 14)
)
trajectory_plot
## collaps the facets
combined_trajectory_plot <- mt_plot_aggregate(
mt_data,
use = "tn_trajectories",
color = "condition",
linetype = "response",
subject_id = "participant_id",
size = 1
) +
scale_color_manual(
values = c(
"Strong prime" = cbPalette[1],
"Weak prime"   = cbPalette[2]
),
name = "Prime condition"
) +
scale_linetype_manual(
values = c(
"Strong" = "solid",
"Weak"   = "dotted"
),
name = "Response"
) +
scale_x_continuous(
breaks = c(0, 0.25, 0.5, 0.75, 1),
labels = c("0.50", "0.25", "0", "0.25", "0.50")
) +
coord_equal(
xlim = c(0, 1),
ylim = c(0, 0.75)
) +
labs(
x = "Horizontal distance from screen center",
y = "Normalized vertical mouse position"
)+
labs(
x = "Normalized horizontal mouse position",
y = "Normalized vertical mouse position"
) +
guides(
color = guide_legend(order = 1),
linetype = guide_legend(order = 2)
) +
theme_bw() +
theme(
legend.position = "bottom",
legend.box = "vertical",
legend.direction = "horizontal",
axis.title = element_text(size = 15),
axis.text = element_text(size = 12),
legend.title = element_text(size = 14),
legend.text = element_text(size = 12)
)
combined_trajectory_plot
###### Calculate the AUC for each condition/response combination
# flip everything to the right
mouse_long_auc <- mouse_data %>%
mutate(
condition = str_replace_all(condition, "_", "-")
) %>%
filter(
valid_response,
trial_type == "3",
condition %in% c("strong-prime", "weak-prime")
) %>%
mutate(
response = case_when(
selected_picture == "cover.png" ~ "Strong",
!is.na(selected_picture) ~ "Weak",
TRUE ~ NA_character_
),
x_raw = x_px / trace_width_px,
y_raw = y_px / trace_height_px,
# Align every selected response to the right
xpos = case_when(
selected_side == "left" ~ 1 - x_raw,
selected_side == "right" ~ x_raw,
TRUE ~ NA_real_
),
ypos = 1 - y_raw,
timestamps = time_ms,
mt_seq = sample_index,
mt_id = paste(participant_id, item_order, sep = "_"),
condition = factor(
condition,
levels = c("strong-prime", "weak-prime"),
labels = c("Strong prime", "Weak prime")
),
response = factor(
response,
levels = c("Strong", "Weak")
)
) %>%
filter(
!is.na(response),
!is.na(xpos),
!is.na(ypos)
) %>%
transmute(
mt_id,
mt_seq,
timestamps,
xpos,
ypos,
participant_id,
item_order,
condition,
response
)
#calculate trial-level AUC
mt_auc <- mt_import_long(
raw_data = mouse_long_auc,
xpos_label = "xpos",
ypos_label = "ypos",
timestamps_label = "timestamps",
mt_id_label = "mt_id",
mt_seq_label = "mt_seq",
reset_timestamps = TRUE
)
mt_auc <- mt_measures(
mt_auc,
use = "trajectories"
)
trial_auc <- mt_auc$data %>%
left_join(
mt_auc$measures %>%
select(mt_id, AUC),
by = "mt_id"
)
#average and 95CI by participant
participant_auc <- trial_auc %>%
group_by(participant_id, condition, response) %>%
summarise(
mean_AUC = mean(AUC, na.rm = TRUE),
n_trials = sum(!is.na(AUC)),
.groups = "drop"
)
auc_summary <- participant_auc %>%
group_by(condition, response) %>%
summarise(
Mean = mean(mean_AUC, na.rm = TRUE),
CILow = ci.low(mean_AUC),
CIHigh = ci.high(mean_AUC),
N = sum(!is.na(mean_AUC)),
.groups = "drop"
) %>%
mutate(
YMin = Mean - CILow,
YMax = Mean + CIHigh
)
auc_summary
#AUC plot
auc_plot <- ggplot(
auc_summary,
aes(x = condition, y = Mean, fill = response)
) +
geom_col(
position = position_dodge(width = 0.8),
width = 0.7
) +
geom_errorbar(
aes(ymin = YMin, ymax = YMax),
position = position_dodge(width = 0.8),
width = 0.25,
linewidth = 0.9
) +
scale_fill_manual(
values = c(
"Strong" = cbPalette[1],
"Weak" = cbPalette[2]
),
name = "Response"
) +
labs(
x = "Prime condition",
y = "Mean area under the curve"
) +
theme_bw() +
theme(
legend.position = "bottom",
axis.title = element_text(size = 16),
axis.text = element_text(size = 14),
legend.title = element_text(size = 14),
legend.text = element_text(size = 13)
)
auc_plot

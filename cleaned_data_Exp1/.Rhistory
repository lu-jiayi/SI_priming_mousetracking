mutate(condition = factor(
condition,
levels = c("Weak prime", "Strong prime")
),
response = factor(
response,
levels = c("Weak", "Strong")
)
)
# Sum coding
contrasts(trial_auc_for_analysis$response) <- contr.sum(nlevels(trial_auc_for_analysis$response))
contrasts(trial_auc_for_analysis$condition) <- contr.sum(nlevels(trial_auc_for_analysis$condition))
auc_model <- lmer(AUC ~ response * condition + (1+response * condition|participant_id), data = trial_auc_for_analysis)
